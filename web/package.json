{
  "name": "shelfready-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/demo-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:public": "playwright test --config playwright.public.config.ts",
    "predev": "node scripts/brand-assets.mjs",
    "prebuild": "node scripts/brand-assets.mjs",
    "format:check": "prettier --check src scripts/brand-assets.mjs e2e/ui.spec.ts e2e/rehearsal.spec.ts playwright.config.ts package.json index.html"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.187.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
