{
  "name": "shelfready-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/demo-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:public": "playwright test --config playwright.public.config.ts",
    "predev": "node scripts/brand-assets.mjs",
    "prebuild": "node scripts/brand-assets.mjs",
    "format:check": "prettier --check src scripts/brand-assets.mjs e2e/{ui,scroll,motion,cinema,rehearsal,deep-link}.spec.ts playwright{,.ci,.cinematic}.config.ts package.json index.html",
    "typecheck": "tsc --noEmit",
    "test:ci": "playwright test --config playwright.ci.config.ts",
    "test:cinematic": "playwright test --config playwright.cinematic.config.ts",
    "test:live": "playwright test --config playwright.config.ts rehearsal.spec.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
